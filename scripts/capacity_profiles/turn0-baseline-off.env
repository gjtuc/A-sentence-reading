# Turn 0 — pre-173 baseline, cold server (minScale 0).
# 173a/b/c off. Inline ingest on API. CPU throttling ON.
ASR_CAPACITY_PROFILE=turn0-baseline-off
ASR_MIN_INSTANCES=0
ASR_CLOUD_RUN_MEMORY=1Gi
ASR_CLOUD_RUN_CPU=1
ASR_MAX_INSTANCES=3
ASR_CLOUD_RUN_CONCURRENCY=80
ASR_CPU_THROTTLING=1
ASR_ACCESS_GATE_TTL_S=0
ASR_INGEST_INLINE=1
CLEAR_WORKER_ENV=1
SCALE_WORKER_MIN=0

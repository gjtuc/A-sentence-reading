# Turn 2 scale-to-zero — fat when busy, cold when idle (rare uploads).
# Same as turn2-current-173 except API min=0 (worker already 0).
# Throttle OFF so mid-job CPU is not starved after wake.
# Not turn3: throttling ON would fight "fast when awake".
ASR_CAPACITY_PROFILE=turn2-scale-to-zero
ASR_MIN_INSTANCES=0
ASR_CLOUD_RUN_MEMORY=2Gi
ASR_CLOUD_RUN_CPU=2
ASR_MAX_INSTANCES=6
ASR_CLOUD_RUN_CONCURRENCY=16
ASR_CPU_THROTTLING=0
ASR_ACCESS_GATE_TTL_S=45
ASR_INGEST_INLINE=0
DEPLOY_WORKER=1
ASR_WORKER_MIN_INSTANCES=0
ASR_WORKER_CPU_THROTTLING=0

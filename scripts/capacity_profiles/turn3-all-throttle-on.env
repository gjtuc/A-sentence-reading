# Turn 3 — all throttling ON (cost down; may worsen mid-job CPU).
ASR_CAPACITY_PROFILE=turn3-all-throttle-on
ASR_MIN_INSTANCES=1
ASR_CLOUD_RUN_MEMORY=2Gi
ASR_CLOUD_RUN_CPU=2
ASR_MAX_INSTANCES=6
ASR_CLOUD_RUN_CONCURRENCY=16
ASR_CPU_THROTTLING=1
ASR_ACCESS_GATE_TTL_S=45
ASR_INGEST_INLINE=0
DEPLOY_WORKER=1
ASR_WORKER_MIN_INSTANCES=0
ASR_WORKER_CPU_THROTTLING=1
